<?xml version="1.0" encoding="utf-8"?>
<!-- Last chip in Главное's subscription row: opens AddSubscriptionSheet. Tonal, not checkable,
     so the row's single selection never lands on it. -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_add_subscription"
    style="@style/Widget.Material3.Chip.Assist"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:text="@string/add_sub_chip"
    android:textColor="?attr/colorOnSecondaryContainer"
    app:chipBackgroundColor="?attr/colorSecondaryContainer"
    app:chipIcon="@drawable/ic_add_24dp"
    app:chipIconTint="?attr/colorOnSecondaryContainer"
    app:chipStrokeWidth="0dp" />
