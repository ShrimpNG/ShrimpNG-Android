<?xml version="1.0" encoding="utf-8"?>
<!-- UpdatesActivity: this version and what's newer, the update options, and the changelog. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_spacing_dp8"
        android:paddingBottom="@dimen/padding_spacing_dp24">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            style="@style/Widget.ShrimpNG.GroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_spacing_dp16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_status"
                        style="@style/Widget.ShrimpNG.SettingsHubRowIcon"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:tint="?attr/colorOnPrimaryContainer"
                        app:srcCompat="@drawable/ic_check_update_24dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_spacing_dp16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_status_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_download"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_spacing_dp16"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_status_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_spacing_dp16"
                    android:lineSpacingMultiplier="1.15"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_spacing_dp16"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_secondary"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/padding_spacing_dp8"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.ShrimpNG.GroupLabel"
            android:text="@string/update_group_options" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.ShrimpNG.GroupCard">

            <LinearLayout style="@style/Widget.ShrimpNG.GroupCardContent">

                <include
                    android:id="@+id/row_auto_check"
                    layout="@layout/layout_update_switch_row" />

                <include
                    android:id="@+id/row_auto_download"
                    layout="@layout/layout_update_switch_row" />

                <include
                    android:id="@+id/row_wifi_only"
                    layout="@layout/layout_update_switch_row" />

                <include
                    android:id="@+id/row_auto_install"
                    layout="@layout/layout_update_switch_row" />

                <include
                    android:id="@+id/row_beta"
                    layout="@layout/layout_update_switch_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_history_label"
            style="@style/Widget.ShrimpNG.GroupLabel"
            android:text="@string/update_group_history" />

        <LinearLayout
            android:id="@+id/list_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
