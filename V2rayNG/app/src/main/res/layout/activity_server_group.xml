<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.ServerCustomConfigActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/form_horizontal_padding"
        android:paddingTop="@dimen/padding_spacing_dp16"
        android:paddingBottom="@dimen/padding_spacing_dp32">

        <TextView
            style="@style/Widget.ShrimpNG.FormSectionHeader"
            android:layout_marginTop="0dp"
            android:text="@string/title_server" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.TextField"
            android:hint="@string/server_lab_remarks">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_remarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.v2ray.ang.ui.widget.DropdownField
            android:id="@+id/sp_policy_group_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.Dropdown"
            android:hint="@string/title_policy_group_type"
            app:entries="@array/policy_group_type" />

        <com.v2ray.ang.ui.widget.DropdownField
            android:id="@+id/sp_policy_group_sub_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.Dropdown"
            android:hint="@string/title_policy_group_subscription_id"
            app:entries="@array/policy_group_type" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.TextField"
            android:hint="@string/title_policy_group_subscription_filter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_policy_group_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
