<?xml version="1.0" encoding="utf-8"?>
<!--
     One tile of a grouped settings list (GroupedPreferenceFragment). The tile's rounded,
     position-dependent background and its margins are applied by the adapter at bind time,
     because they depend on the neighbours. The ids are the ones androidx.preference binds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_spacing_dp16"
    android:paddingVertical="@dimen/padding_spacing_dp12">

    <FrameLayout
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_spacing_dp16"
        android:visibility="gone">

        <androidx.preference.internal.PreferenceImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@color/preference_m3_summary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/preference_m3_title" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="10"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/preference_m3_summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_spacing_dp16"
        android:gravity="center"
        android:orientation="vertical" />

</LinearLayout>
