<?xml version="1.0" encoding="utf-8"?>
<!--
     Per-app proxy, in the grouped-tile style of the settings screens: two switch tiles, the
     filter/sort chips, then the apps as one group of tiles. The header is moved into the list by
     PerAppProxyActivity, so it scrolls away with it; the list has a draggable fast scroller with a letter bubble (FastScrollerView).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ui.PerAppProxyActivity">

    <LinearLayout
        android:id="@+id/header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_spacing_dp8"
        android:paddingBottom="@dimen/padding_spacing_dp8">

        <LinearLayout
            android:id="@+id/container_per_app_proxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_spacing_dp16"
            android:paddingVertical="@dimen/padding_spacing_dp12">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_spacing_dp16"
                android:layout_weight="1"
                android:text="@string/per_app_proxy_settings_enable"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_per_app_proxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:minHeight="0dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_bypass_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_spacing_dp16"
            android:paddingVertical="@dimen/padding_spacing_dp12">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding_spacing_dp16"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_bypass_apps_mode"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <!-- What the current mode does with the ticked apps; set by PerAppProxyActivity. -->
                <TextView
                    android:id="@+id/tv_bypass_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_bypass_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:minHeight="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_apps_label"
            style="@style/Widget.ShrimpNG.ThemeGroupLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp16" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_app_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/padding_spacing_dp8"
            app:singleLine="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_selected_first"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/per_app_chip_selected_first" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_show_system"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/per_app_chip_show_system" />
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/padding_spacing_dp16"
            android:paddingBottom="@dimen/padding_spacing_dp24"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Draggable thumb with a letter bubble; touches off the thumb fall through. -->
        <com.v2ray.ang.ui.widget.FastScrollerView
            android:id="@+id/fast_scroller"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</LinearLayout>
