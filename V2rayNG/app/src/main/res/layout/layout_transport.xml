<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.ShrimpNG.FormSectionHeader"
        android:text="@string/server_lab_more_function" />

    <com.v2ray.ang.ui.widget.DropdownField
        android:id="@+id/sp_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.ShrimpNG.Dropdown"
        android:hint="@string/server_lab_network"
        app:entries="@array/networks" />

    <com.v2ray.ang.ui.widget.DropdownField
        android:id="@+id/sp_header_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.ShrimpNG.Dropdown"
        android:hint="@string/server_lab_head_type" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tv_request_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.ShrimpNG.TextField"
        android:hint="@string/server_lab_request_host">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_request_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tv_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.ShrimpNG.TextField"
        android:hint="@string/server_lab_path">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layout_kcp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.TextField"
            android:hint="@string/server_lab_kcp_mtu">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_kcp_mtu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.TextField"
            android:hint="@string/server_lab_kcp_tti">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_kcp_tti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.TextField"
            android:hint="@string/server_lab_xhttp_extra">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="20"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_fm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.TextField"
            android:hint="@string/server_lab_final_mask">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_fm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="20"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_browser_dialer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.v2ray.ang.ui.widget.DropdownField
            android:id="@+id/sp_browser_dialer_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.ShrimpNG.Dropdown"
            android:hint="@string/server_lab_browser_dialer"
            app:entries="@array/browser_dialer_mode"
            app:helperText="@string/server_lab_browser_dialer_tip"
            app:helperTextEnabled="true" />
    </LinearLayout>
</LinearLayout>
