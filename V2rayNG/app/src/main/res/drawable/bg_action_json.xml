<?xml version="1.0" encoding="utf-8"?>
<!-- Its own rounded corners, rather than a clip on the row of buttons: clipToOutline is not
     anti-aliased, and the corners came out stepped. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</ripple>
